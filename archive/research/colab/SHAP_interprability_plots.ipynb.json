   "source": [
    "# Cell 5: Statistical tests\n",
    "# 1. Paired t-test (assumes paired samples)\n",
    "t_stat, t_p = stats.ttest_rel(arr1, arr2)\n",
    "\n",
    "# 2. Wilcoxon signed-rank test (non-parametric paired)\n",
    "w_stat, w_p = stats.wilcoxon(arr1, arr2)\n",
    "\n",
    "# 3. Pearson correlation coefficient\n",
    "pearson_r, pearson_p = stats.pearsonr(arr1, arr2)\n",
    "\n",
    "results = pd.DataFrame({\n",
    "    'Test': ['Paired t-test', 'Wilcoxon signed-rank', 'Pearson correlation'],\n",
    "    'Statistic': [t_stat, w_stat, pearson_r],\n",
    "    'p-value': [t_p, w_p, pearson_p]\n",
    "})\n",
    "\n",
    "print(\"Statistical Test Results:\")\n",
    "print(results)"
   ],
