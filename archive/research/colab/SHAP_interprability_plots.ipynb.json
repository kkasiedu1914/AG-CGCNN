    "# Compare rank of 2 shap values\n",
    "import torch\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from scipy.stats import spearmanr, wilcoxon\n",
    "\n",
    "# Raw SHAP values (tensors)\n",
    "norm_model_shap = torch.tensor([\n",
    "    [ 3.5173e+01,  6.0133e+01,  2.3594e+01,  2.3109e-02, -1.3684e+01,\n",
    "         -4.4073e+01, -2.6299e+00, -3.5214e-04, -4.7653e+00, -3.4979e-02,\n",
    "         -3.4185e+00,  2.0807e+00, -9.9235e-02, -9.2718e-02, -1.2244e-01,\n",
    "          1.9493e+00,  9.8985e-01,  1.3537e+00,  1.1902e+01, -5.8105e-02,\n",
    "          6.1244e+00, -3.2733e-02, -1.6547e-01,  2.7561e+00,  2.0393e+00,\n",
    "          5.0821e+00, -2.0705e-01, -4.4065e+01, -9.7179e-01, -1.2676e-02,\n",
    "         -1.3331e-01,  2.3284e-01, -6.3486e+00, -4.4090e+01,  1.4033e+00,\n",
    "          2.3860e+00, -7.8164e-02,  1.4339e+00, -4.4084e+01, -3.2811e-02,\n",
    "         -1.2983e-02, -1.3011e+01,  1.3437e+00,  1.7768e+00, -2.1593e-01,\n",
    "         -4.4083e+01, -1.0119e-01,  1.4972e-01,  6.4480e+01, -4.4074e+01,\n",
    "         -6.0226e-02, -4.4074e+01, -1.6831e-02, -4.4074e+01,  1.9227e-02,\n",
    "         -5.1558e-02, -1.0180e-01, -2.3922e-01,  5.9437e+01,  2.8505e-01,\n",
    "          1.5942e+01, -4.4072e+01, -4.4072e+01,  2.5951e-01,  3.1630e-01,\n",
    "         -4.4073e+01,  2.6651e-01, -4.5008e-02,  3.9897e+01, -1.7287e+00,\n",
    "          1.8739e+00,  2.3556e-01,  5.4726e-02,  6.9393e-02, -4.4079e+01,\n",
    "          2.8670e+00, -1.5590e-03, -1.6399e-02,  1.8557e+00, -1.0456e-01,\n",
    "          7.3266e+00,  7.8382e+00,  1.0403e+01, -2.0121e-01, -5.5762e-01,\n",
    "          1.6360e+00,  1.3646e+00,  1.1998e+00,  2.5163e+00,  6.0393e+01,\n",
    "         -1.0904e+01,  4.7226e+01,  7.3697e-02,  8.2513e-02,  8.3082e-02,\n",
    "          4.1517e+01,  5.4684e-02, -4.4073e+01,  6.1585e+01, -2.2493e+00,\n",
    "          3.2209e+01,  3.2570e-02, -5.5428e-02, -4.5855e-02, -1.5721e-01,\n",
    "          8.2344e-01, -3.0311e-02,  4.6615e+02]\n",
    "])\n",
    "\n",
    "pretrain_model_shap = torch.tensor([\n",
    "   [ 2.1891e+00,  1.1451e+00,  2.4145e+00, -1.3478e+00,  5.7572e+01,\n",
    "         -1.0097e+01,  8.5716e+00, -1.1909e+00,  9.3079e+00, -1.2135e+00,\n",
    "          1.1054e+01,  1.0919e+00, -1.3126e+00, -1.2806e+00, -1.2878e+00,\n",
    "          3.4889e-01,  1.8158e+00, -5.4987e+00,  1.3820e+00, -1.3590e+00,\n",
    "         -3.5348e+00, -1.2880e+00, -1.4120e+00, -8.6462e-01,  3.2907e-01,\n",
    "         -3.0018e+00, -1.3359e+00, -1.0088e+01,  5.6092e-01, -1.2394e+00,\n",
    "          6.5574e-01,  3.5736e-01,  2.7360e+00, -1.0095e+01, -2.7865e+00,\n",
    "          6.9457e-01, -1.3500e+00,  5.1241e-01, -1.0094e+01, -1.2425e+00,\n",
    "         -1.1627e+00,  5.8229e+01,  2.3126e+00,  1.1475e-01, -1.1952e+00,\n",
    "         -1.0094e+01, -1.1479e+00, -1.1133e+00,  1.6624e+00, -1.0091e+01,\n",
    "         -1.1945e+00, -1.0092e+01, -1.0528e+00, -1.0090e+01, -1.1548e+00,\n",
    "         -1.1868e+00, -1.3128e+00, -1.3814e+00,  1.2493e+00, -1.3958e+00,\n",
    "          3.3724e+00, -1.0090e+01, -1.0090e+01,  3.7568e+00, -1.1869e+00,\n",
    "         -1.0090e+01,  1.2289e+00, -1.2333e+00,  1.5125e+00,  8.5461e-01,\n",
    "          2.9301e+00, -1.1360e+00, -1.2286e+00, -1.2220e+00, -1.0094e+01,\n",
    "         -1.3005e+00, -1.2121e+00, -1.2140e+00,  9.4699e-01, -1.2702e+00,\n",
    "          1.0718e+00, -2.2043e+00, -1.2208e+00, -1.2882e+00,  4.8920e-01,\n",
    "         -5.1212e-01,  1.1479e+00,  6.7168e-01,  2.1506e+00,  2.6073e+00,\n",
    "          2.8942e-01,  1.2698e+00, -8.0687e-01, -1.0864e+00, -1.0926e+00,\n",
    "          1.6024e+00, -1.3311e+00, -1.0090e+01,  1.2180e+00,  2.9424e+00,\n",
    "          1.8064e+00, -1.1908e+00, -1.2517e+00, -1.1652e+00, -1.2494e+00,\n",
    "         -1.2269e+00, -1.2441e+00,  1.8495e+02]\n",
    "])\n",
    "\n",
    "# Convert to numpy\n",
    "norm_vals = norm_model_shap.numpy().flatten()\n",
    "pretrain_vals = pretrain_model_shap.numpy().flatten()\n",
    "\n",
    "# Rank the SHAP values (higher is more important, so descending order)\n",
    "norm_ranks = (-norm_vals).argsort().argsort() + 1  # rank 1 is highest value\n",
    "pretrain_ranks = (-pretrain_vals).argsort().argsort() + 1\n",
    "\n",
    "# Spearman rank correlation\n",
    "spearman_corr, spearman_p = spearmanr(norm_ranks, pretrain_ranks)\n",
    "\n",
    "# Wilcoxon test (test if rank differences are symmetric around 0)\n",
    "wilcoxon_stat, wilcoxon_p = wilcoxon(norm_ranks, pretrain_ranks)\n",
    "\n",
    "# Differences\n",
    "rank_diff = norm_ranks - pretrain_ranks\n",
    "\n",
    "# Create dataframe for inspection\n",
    "df = pd.DataFrame({\n",
    "    'Feature': np.arange(len(norm_ranks)),\n",
    "    'Norm Rank': norm_ranks,\n",
    "    'Pretrain Rank': pretrain_ranks,\n",
    "    'Rank Difference': rank_diff\n",
    "})\n",
    "\n",
    "# Sort for visualization\n",
    "df_sorted = df.sort_values('Norm Rank')\n",
    "\n",
    "# Plot\n",
    "plt.figure(figsize=(12, 6))\n",
    "sns.lineplot(data=df_sorted, x='Feature', y='Norm Rank', label='Norm Model', marker='o')\n",
    "sns.lineplot(data=df_sorted, x='Feature', y='Pretrain Rank', label='Pretrained Model', marker='s')\n",
    "plt.title('Feature Rank Comparison between Norm and Pretrained Models')\n",
    "plt.ylabel('Rank (Lower is More Important)')\n",
    "plt.xlabel('Feature Index')\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Print stats\n",
    "print(\"=== Spearman's Rank Correlation ===\")\n",
    "print(f\"Correlation: {spearman_corr:.4f}, p-value: {spearman_p:.4e}\")\n",
    "\n",
    "print(\"\\n=== Wilcoxon Signed-Rank Test ===\")\n",
    "print(f\"Statistic: {wilcoxon_stat:.4f}, p-value: {wilcoxon_p:.4e}\")\n",
    "\n",
    "print(\"\\nTop 10 Rank Differences:\")\n",
    "print(df_sorted.head(10))\n"
   ],
